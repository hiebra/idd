{
  "name": "acceptance-tests",
  "version": "0.0.0",
  "private": true,
  "description": "Acceptance suite: executes the Gherkin in openspec/**/spec.md with cucumber-js",
  "scripts": {
    "test": "cucumber-js",
    "test:specs": "cucumber-js -p specs",
    "test:windows": "cucumber-js -p windows",
    "lint:specs": "node extract-gherkin.cjs && gplint .extracted",
    "test:core": "node --test \"core-tests/*.test.js\""
  },
  "devDependencies": {
    "@cucumber/cucumber": "^13.3.0",
    "cheerio": "^1.2.0",
    "glob": "^14.0.6",
    "gplint": "^2.6.2"
  }
}
