{
  // Pinned gplint config for the EXTRACTED .feature files under
  // .extracted/ (gplint enables no rule that is not listed here).
  // Copy to acceptance-tests/.gplintrc (that name is auto-discovered).
  // Line numbers it reports are valid in the source spec.md files.
  // Use only "error" and "off": on any other level (such as the old "on")
  // gplint throws, yet exits 0 without linting anything.
  //
  // Deliberately OFF because enabling these makes "fix all lint issues"
  // unsatisfiable with this toolchain:
  //   no-multiple-empty-lines / new-line-at-eof / indentation:
  //     extraction pads prose to blank lines to preserve line numbers.
  //   no-dupe-feature-names:
  //     a delta spec and its source-of-truth spec share the Feature name.
  //   no-dupe-scenario-names:
  //     a MODIFIED delta copies the whole Rule, scenario names included.
  "no-empty-file": "error",
  "no-files-without-scenarios": "error",
  "no-unnamed-features": "error",
  "no-unnamed-scenarios": "error",
  "no-dupe-feature-names": "off",
  "no-dupe-scenario-names": "off",
  "no-duplicate-tags": "error",
  "no-partially-commented-tag-lines": "error",
  "one-space-between-tags": "error",
  "no-empty-background": "error",
  "no-background-only-scenario": "error",
  "no-scenario-outlines-without-examples": "error",
  "no-examples-in-scenarios": "error",
  "no-trailing-spaces": "error",
  "no-multiple-empty-lines": "off",
  "new-line-at-eof": "off",
  "indentation": "off"
}
